<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{{report.title}} - 打印</title>

  <style>
    body {
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      line-height: 1.8;
      color: #222;
    }

    h1 {
      font-size: 28px;
      margin-bottom: 16px;
    }

    .metadata {
      color: #666;
      font-size: 14px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }

    .content {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      font-family: inherit;
    }

    @media print {
      body {
        margin: 0;
        padding: 0;
      }
    }
  </style>
</head>

<body>
  <article>
    <h1>{{report.title}}</h1>

    <div class="metadata">
      <p>AI Model：{{report.model}}</p>
      <p>生成时间：{{report.createdAt}}</p>
      <p>状态：{{report.status}}</p>
    </div>

    <section>
      <h2>研究内容</h2>

      <div class="content">
        {{report.content}}
      </div>
    </section>
  </article>
</body>
</html>
